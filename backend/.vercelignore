# Ignore root entries, then allow the deployment inputs and their contents.
# Root anchoring avoids applying the blanket exclusion inside allowed folders.
/*
!/api
!/src
!/package.json
!/package-lock.json
!/tsconfig.json
!/vercel.json
!/.vercelignore
!/config
/config/*
!/config/backend-config.json
!/scripts
/scripts/*
!/scripts/check-config.mjs
!/public
/public/*
!/public/m12

# Git deployments may apply this project file from the repository root.
!/backend
/backend/*
!/backend/api
!/backend/src
!/backend/package.json
!/backend/package-lock.json
!/backend/tsconfig.json
!/backend/vercel.json
!/backend/.vercelignore
!/backend/config
/backend/config/*
!/backend/config/backend-config.json
!/backend/scripts
/backend/scripts/*
!/backend/scripts/check-config.mjs
!/backend/public
/backend/public/*
!/backend/public/m12
