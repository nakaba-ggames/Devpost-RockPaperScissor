# Reviewed M12 upload allowlist. Only this candidate, API and generated configuration.
*
!api/
!api/**
!src/
!src/**
!config/
!config/backend-config.json
!scripts/
!scripts/check-config.mjs
!static-api-only/
!static-api-only/.gitkeep
!package.json
!package-lock.json
!tsconfig.json
!vercel.json
!.vercelignore
!public/
!public/m12/
!public/m12/**

# Allow backend paths when filtering from the repository root.
!backend/
!backend/package.json
!backend/package-lock.json
!backend/tsconfig.json
!backend/vercel.json
!backend/.vercelignore
!backend/api/
!backend/api/**
!backend/src/
!backend/src/**
!backend/config/
!backend/config/backend-config.json
!backend/scripts/
!backend/scripts/check-config.mjs
!backend/public/
!backend/public/m12/
!backend/public/m12/**
