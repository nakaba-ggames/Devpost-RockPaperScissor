{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "static-api-only",
  "functions": {
    "api/*.ts": {
      "includeFiles": "config/backend-config.json",
      "excludeFiles": "{public/**,.env*,.local/**}",
      "maxDuration": 30
    }
  }
}
